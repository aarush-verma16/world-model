\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Benchmark runs, one seed each. (a)\nobreakspace  {}Fraction of handoffs on which the demonstrator went on to craft the iron pickaxe, with 95\% Wilson intervals. Walking back to the station roughly halved it. (b)\nobreakspace  {}Held-out lives played by the actor alone: it reaches the stone pickaxe, the precondition for the rare craft, in two to six of ten lives at 100k steps, and never crafts the iron pickaxe (crosses). (c)\nobreakspace  {}Cumulative training lives with a stone pickaxe (solid) and with an actor-only iron pickaxe (dotted, zero throughout). Gray lines mark the demonstrator injections every 25k steps.\relax }}{9}{figure.caption.27}\protected@file@percent }
\newlabel{fig:benchmark}{{4}{9}{Benchmark runs, one seed each. (a)~Fraction of handoffs on which the demonstrator went on to craft the iron pickaxe, with 95\% Wilson intervals. Walking back to the station roughly halved it. (b)~Held-out lives played by the actor alone: it reaches the stone pickaxe, the precondition for the rare craft, in two to six of ten lives at 100k steps, and never crafts the iron pickaxe (crosses). (c)~Cumulative training lives with a stone pickaxe (solid) and with an actor-only iron pickaxe (dotted, zero throughout). Gray lines mark the demonstrator injections every 25k steps.\relax }{figure.caption.27}{}}
\newlabel{fig:benchmark@cref}{{[figure][4][]4}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The $64\times 64$ observation from the cell south of the station. Each tile is $16\times 16$ pixels, one cell of the encoder's final feature map. (a) The station (orange) is in the nearest row. (b) The station is one cell behind the agent and absent from the image; \texttt  {use} succeeds from here only in the behind-agent condition. These are environment frames, not reconstructions.\relax }}{9}{figure.caption.32}\protected@file@percent }
\newlabel{fig:room-crops}{{5}{9}{The $64\times 64$ observation from the cell south of the station. Each tile is $16\times 16$ pixels, one cell of the encoder's final feature map. (a) The station (orange) is in the nearest row. (b) The station is one cell behind the agent and absent from the image; \texttt {use} succeeds from here only in the behind-agent condition. These are environment frames, not reconstructions.\relax }{figure.caption.32}{}}
