# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg-info/**
.eggs/
dist/
build/
*.egg
.venv/
venv/
src/*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Conda
.conda/

# Checkpoints & replay (track via Git LFS when needed)
*.pt
*.ckpt
*.pth
checkpoints/
data/
replay/
*.pkl
*.npz

# Experiment artifacts (keep folder structure, ignore run outputs)
experiments/*/
!experiments/.gitkeep

# Results artifacts (keep select milestone proof images tracked)
results/**
!results/.gitkeep
!results/m0_random_rollout.gif
!results/m1/
!results/m1/recon_final.png
!results/m1/recon_diverse_check.png
!results/m2/
!results/m2/*.png
# M3 run outputs stay local (intermediate recon grids + metrics are noisy).
# Un-ignore a single proof image later if/when quality is worth committing.

# Matplotlib cache (created by scripts/visualize_rssm.py in sandboxed HOME dirs)
.mplcache/

# TensorBoard (keep M0 dummy events out of git; regenerate via scripts)
runs/
logs/
tb_logs/

# MkDocs
site/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Env / secrets
.env
.env.*

# Videos (track via Git LFS when needed)
*.mp4
*.gif
!docs/**/*.gif
